NODE_ENV=development
PORT=4000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/auth_sphere"

# Generate strong secrets, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token

CORS_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# Used only by prisma/seed.ts
SEED_ADMIN_EMAIL=admin@auth-sphere.local
SEED_ADMIN_PASSWORD=ChangeMe123!